# Mẫu biến môi trường — copy thành .env rồi điền giá trị thật.
# Tất cả chỉ dùng phía server. KHÔNG thêm tiền tố NEXT_PUBLIC_.

# Postgres (Neon) — bắt buộc
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Ký cookie danh tính (bắt buộc). Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Cloudflare R2 — để trống thì app vẫn chạy, chỉ tắt upload
CLOUDFLARE_API_TOKEN=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

R2_BUCKET=
R2_PUBLIC_URL=

# Chuyển mã video (không bắt buộc) — để gọi worker GitHub Actions ngay khi có video mới.
# Token fine-grained của repo, quyền "Contents: Read and write". Thiếu thì worker vẫn chạy theo lịch.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=NT101-lc/PhotoArchive
